# GitHub Container Registry image owner. Usually your GitHub username or organization,
# lower-case. The deploy workflow exports this automatically, but keeping it here makes
# manual server commands easier.
GHCR_OWNER=your-github-owner
IMAGE_TAG=latest

# Public origin served by host nginx.
PUBLIC_SITE_ORIGIN=https://example.com

# Runtime URL used by Next.js server-side requests inside Docker.
API_URL=http://api:5000

# Browser-facing API base path. With host nginx routing /api to the backend,
# both frontends can use a same-origin relative URL.
NEXT_PUBLIC_API_URL=/api
VITE_API_BASE_URL=/api

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Backend
ASPNETCORE_ENVIRONMENT=Production
Database__ApplyMigrationsOnStartup=true

# Initial or updated admin seed credentials. The backend stores the password as a hash.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password

# JWT. JWT_SECRET must be at least 32 characters.
JWT_ISSUER=portfolio
JWT_AUDIENCE=portfolio-admin
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_LIFETIME_MINUTES=60

# SeaweedFS / S3-compatible storage
STORAGE_PUBLIC_BASE_URL=https://example.com/files/portfolio
STORAGE_BUCKET_NAME=portfolio
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
