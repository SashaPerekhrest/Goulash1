# Production environment for the subdomain-root deployment.
# Replace example.com with the exact hostname before using this file.

# GitHub Container Registry owner. GitHub Actions sets this during automated deploys.
GHCR_OWNER=your-github-owner
IMAGE_TAG=latest

# Public origin and uploaded-file URLs.
PUBLIC_SITE_ORIGIN=https://portfolio.example.com
STORAGE_PUBLIC_BASE_URL=https://portfolio.example.com/files/portfolio

# Public Web uses the domain root. Keep this empty and sync it with the workflow.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_URL=/api
API_URL=http://api:5000

# Admin container's internal nginx serves the admin app at this path.
ADMIN_BASE_PATH=/admin

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Backend
ASPNETCORE_ENVIRONMENT=Production
Database__ApplyMigrationsOnStartup=true
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password

# JWT_SECRET must be at least 32 characters.
JWT_ISSUER=portfolio
JWT_AUDIENCE=portfolio-admin
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_LIFETIME_MINUTES=60

# SeaweedFS / S3-compatible storage
STORAGE_BUCKET_NAME=portfolio
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
