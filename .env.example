# Common local URLs
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:5173/admin
# Server-side public-web requests run inside Docker Compose and use the service name.
API_URL=http://api:5000
# Browser-visible API URLs stay on localhost for local Docker Compose.
NEXT_PUBLIC_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=portfolio_dev_password
Database__ApplyMigrationsOnStartup=true

# Development seed only. Replace for local runs and never commit real credentials.
Seed__Admin__Login=docker-admin
Seed__Admin__Password=portfolio_dev_password
SEED_ADMIN_LOGIN=docker-admin
SEED_ADMIN_PASSWORD=portfolio_dev_password

# SeaweedFS / S3-compatible storage
# Backend container uses the Docker Compose service name.
Storage__Endpoint=http://seaweedfs:8333
# Browser-visible URL stays on localhost in local development.
Storage__PublicBaseUrl=http://localhost:8333/portfolio
Storage__BucketName=portfolio
Storage__ForcePathStyle=true
Storage__CreateBucketIfNotExists=true
Storage__Region=us-east-1
Storage__AccessKey=
Storage__SecretKey=
STORAGE_BUCKET_NAME=portfolio
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# JWT
Jwt__Issuer=portfolio
Jwt__Audience=portfolio-admin
Jwt__Secret=replace-with-a-long-local-development-secret
Jwt__LifetimeMinutes=60
JWT_ISSUER=portfolio
JWT_AUDIENCE=portfolio-admin
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_LIFETIME_MINUTES=60
