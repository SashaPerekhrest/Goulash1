# Common local URLs
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:5173/admin
API_URL=http://localhost:5000

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=change-me-for-local-development

# SeaweedFS / S3-compatible storage
Storage__Endpoint=http://localhost:8333
Storage__PublicBaseUrl=http://localhost:8333/portfolio
Storage__Bucket=portfolio
Storage__AccessKey=change-me
Storage__SecretKey=change-me

# JWT placeholder for later auth sprint
Jwt__Issuer=portfolio
Jwt__Audience=portfolio-admin
Jwt__Secret=replace-with-a-long-local-development-secret
