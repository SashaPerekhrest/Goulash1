# Common local URLs
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:5173/admin
API_URL=http://localhost:5000

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=change-me-for-local-development
Database__ApplyMigrationsOnStartup=true

# Development seed only. Replace for local runs and never commit real credentials.
Seed__Admin__Login=admin
Seed__Admin__Password=change-me-for-local-development

# SeaweedFS / S3-compatible storage
# Backend container uses the Docker Compose service name.
Storage__Endpoint=http://seaweedfs:8333
# Browser-visible URL stays on localhost in local development.
Storage__PublicBaseUrl=http://localhost:8333/portfolio
Storage__BucketName=portfolio
Storage__ForcePathStyle=true
Storage__CreateBucketIfNotExists=true
Storage__Region=us-east-1
Storage__AccessKey=
Storage__SecretKey=

# JWT
Jwt__Issuer=portfolio
Jwt__Audience=portfolio-admin
Jwt__Secret=replace-with-a-long-local-development-secret
Jwt__LifetimeMinutes=60
