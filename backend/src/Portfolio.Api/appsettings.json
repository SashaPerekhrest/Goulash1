{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=portfolio_dev_password"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "Endpoint": "http://localhost:8333",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "portfolio",
    "PublicBaseUrl": "http://localhost:8333/portfolio",
    "ForcePathStyle": true,
    "CreateBucketIfNotExists": true,
    "Region": "us-east-1"
  },
  "Jwt": {
    "Issuer": "Portfolio.Api",
    "Audience": "Portfolio.Admin",
    "LifetimeMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
